---
import { AFFILIATE_LINK } from '../data/pages';

interface Props {
  offerText?: string;
  affiliateUrl?: string;
}

const {
  offerText = "Ready to launch your 24-hour done-for-you AI influencer portfolio?",
  affiliateUrl = AFFILIATE_LINK
} = Astro.props;
---

<div id="sticky-bar" class="fixed bottom-0 inset-x-0 z-50 p-3 sm:p-4 bg-slate-950/95 border-t border-emerald-500/30 backdrop-blur-md shadow-2xl transition-transform duration-300">
  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
    <div class="flex items-center space-x-3 text-center sm:text-left">
      <span class="hidden sm:inline-flex w-3 h-3 rounded-full bg-emerald-400 animate-ping"></span>
      <p class="text-xs sm:text-sm font-medium text-slate-200">
        <strong class="text-emerald-400 font-bold">Limited 2026 Cohort:</strong> {offerText}
      </p>
    </div>

    <div class="flex items-center space-x-3 w-full sm:w-auto justify-center">
      <a
        href={affiliateUrl}
        class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-2.5 text-xs sm:text-sm font-bold rounded-lg bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 hover:from-emerald-400 hover:to-teal-400 transition-all shadow-md active:scale-95"
      >
        <span>Claim Access & Details →</span>
      </a>
    </div>
  </div>
</div>
