---
import { AFFILIATE_LINK } from '../data/pages';

interface Props {
  h1: string;
  badge: string;
  headline: string;
  subheadline: string;
  audience: string;
}

const { h1, badge, headline, subheadline, audience } = Astro.props;
---

<section class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden border-b border-slate-800 bg-gradient-to-b from-slate-900 to-slate-950">
  <!-- Subtle Background Glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-brand-500/10 blur-3xl pointer-events-none -z-10 rounded-full"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Above The Fold Immediate Intent Verification -->
    <div class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs sm:text-sm font-semibold mb-6">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>{badge} • Tailored for {audience}</span>
    </div>

    <!-- Strictly ONE H1 Per Page (Enforcing Defensive SEO Rule) -->
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight mb-6">
      {h1}
    </h1>

    <!-- Above-The-Fold Immediate Value Confirmation -->
    <p class="text-lg sm:text-xl md:text-2xl text-slate-300 font-medium max-w-3xl mx-auto mb-8 leading-relaxed">
      {headline}. <span class="text-slate-400 text-base sm:text-lg block mt-2">{subheadline}</span>
    </p>

    <!-- Immediate High-Intent CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10">
      <a
        href={AFFILIATE_LINK}
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 hover:from-emerald-400 hover:to-teal-400 transition-all shadow-xl shadow-emerald-500/20 active:scale-95"
      >
        <span>Deploy Room30 AI System in 24 Hours</span>
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
      <a
        href="#breakdown"
        class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-4 text-base font-semibold rounded-xl bg-slate-800 hover:bg-slate-750 text-slate-200 border border-slate-700 transition-colors"
      >
        View Model Economics & Proof
      </a>
    </div>

    <!-- Third-Party Authority Signals -->
    <div class="pt-6 border-t border-slate-800/80 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs text-slate-400 font-medium">
      <div class="flex items-center space-x-2">
        <span class="text-emerald-400 font-bold">✓</span>
        <span>100% Done-For-You in 24h</span>
      </div>
      <div class="flex items-center space-x-2">
        <span class="text-emerald-400 font-bold">✓</span>
        <span>Zero Camera or Face Required</span>
      </div>
      <div class="flex items-center space-x-2">
        <span class="text-emerald-400 font-bold">✓</span>
        <span>32,000+ Enrolled Worldwide</span>
      </div>
      <div class="flex items-center space-x-2">
        <span class="text-emerald-400 font-bold">✓</span>
        <span>As Seen on Forbes & Entrepreneur</span>
      </div>
    </div>

  </div>
</section>
