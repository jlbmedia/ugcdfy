---
import { AFFILIATE_LINK } from '../data/pages';
---

<section class="py-16 md:py-24 bg-slate-900/40 border-t border-b border-slate-800">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        Direct Comparison: Room30 vs. Traditional Online Models
      </h2>
      <p class="text-slate-400 text-sm sm:text-base">
        Why analytical buyers and busy professionals choose turnkey faceless AI assets over exhausting DIY side hustles.
      </p>
    </div>

    <!-- Responsive Comparison Table -->
    <div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-950 shadow-2xl mb-12">
      <table class="w-full text-left text-xs sm:text-sm">
        <thead>
          <tr class="border-b border-slate-800 bg-slate-900/90 text-slate-300">
            <th class="p-4 sm:p-5 font-semibold">Feature / Metric</th>
            <th class="p-4 sm:p-5 font-bold text-emerald-400 bg-emerald-950/20 border-x border-emerald-900/40">
              Room30 AI Influencer Portfolio
            </th>
            <th class="p-4 sm:p-5 font-semibold text-slate-400">Dropshipping / E-Com</th>
            <th class="p-4 sm:p-5 font-semibold text-slate-400">Personal YouTube/Vlog</th>
            <th class="p-4 sm:p-5 font-semibold text-slate-400">Freelance Gigs</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60 text-slate-300">
          <tr>
            <td class="p-4 sm:p-5 font-medium text-white">Setup Time</td>
            <td class="p-4 sm:p-5 font-bold text-emerald-400 bg-emerald-950/20 border-x border-emerald-900/40">
              ⚡ 24 Hours (Turnkey)
            </td>
            <td class="p-4 sm:p-5">2 to 6 Months</td>
            <td class="p-4 sm:p-5">6 to 12 Months</td>
            <td class="p-4 sm:p-5">Immediate (Low pay)</td>
          </tr>
          <tr>
            <td class="p-4 sm:p-5 font-medium text-white">On-Camera Required</td>
            <td class="p-4 sm:p-5 font-bold text-emerald-400 bg-emerald-950/20 border-x border-emerald-900/40">
              🛡️ Zero (100% Faceless)
            </td>
            <td class="p-4 sm:p-5">No (High ad cost)</td>
            <td class="p-4 sm:p-5">Yes (100% Public)</td>
            <td class="p-4 sm:p-5">Yes (Client Calls)</td>
          </tr>
          <tr>
            <td class="p-4 sm:p-5 font-medium text-white">Technical Skill Needed</td>
            <td class="p-4 sm:p-5 font-bold text-emerald-400 bg-emerald-950/20 border-x border-emerald-900/40">
              None (Done-For-You)
            </td>
            <td class="p-4 sm:p-5">High (Shopify, Ads, Pixels)</td>
            <td class="p-4 sm:p-5">High (Editing, Lighting)</td>
            <td class="p-4 sm:p-5">Specialized Skill</td>
          </tr>
          <tr>
            <td class="p-4 sm:p-5 font-medium text-white">Daily Commitment</td>
            <td class="p-4 sm:p-5 font-bold text-emerald-400 bg-emerald-950/20 border-x border-emerald-900/40">
              15 Minutes Daily
            </td>
            <td class="p-4 sm:p-5">4–6 Hours Daily</td>
            <td class="p-4 sm:p-5">5–8 Hours Daily</td>
            <td class="p-4 sm:p-5">Trades Time For Cash</td>
          </tr>
          <tr>
            <td class="p-4 sm:p-5 font-medium text-white">High-Ticket Backend</td>
            <td class="p-4 sm:p-5 font-bold text-emerald-400 bg-emerald-950/20 border-x border-emerald-900/40">
              $1,000–$10,000 Payouts
            </td>
            <td class="p-4 sm:p-5">Low Margins (10–15%)</td>
            <td class="p-4 sm:p-5">AdSense Pennies Early On</td>
            <td class="p-4 sm:p-5">Capped Hourly Rates</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Quick Takeaway -->
    <div class="text-center">
      <a
        href={AFFILIATE_LINK}
        class="inline-flex items-center justify-center px-8 py-3.5 text-sm sm:text-base font-bold rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 hover:from-emerald-400 hover:to-teal-400 transition-all shadow-lg active:scale-95"
      >
        <span>Skip the DIY Grind: Claim Done-For-You Portfolio</span>
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>
