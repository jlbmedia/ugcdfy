---
import { AFFILIATE_LINK } from '../data/pages';

interface Props {
  audience: string;
  avatarContext: string;
  painPoints: string[];
  keyBenefits: string[];
  solutionBadge?: string;
  solutionTitle?: string;
  beforeBadge?: string;
  beforeQuote?: string;
  afterBadge?: string;
  afterQuote?: string;
  affiliateUrl?: string;
  midCtaText?: string;
  midCtaSubtext?: string;
  workflowTitle?: string;
  workflowSubtitle?: string;
  isDfyDave?: boolean;
  isLinkStack?: boolean;
  isRoom30?: boolean;
}

const {
  audience,
  avatarContext,
  painPoints,
  keyBenefits,
  solutionBadge = "The Room30 Turnkey Advantage",
  solutionTitle = "Built & Delivered In 24 Hours",
  beforeBadge = "Before Room30",
  beforeQuote = "Exhausted by technical hurdles, constant software subscriptions, and anxiety about putting my face on camera.",
  afterBadge = "After 24-Hour Setup",
  afterQuote = "Effortlessly managing a self-liquidating AI influencer portfolio in 15 minutes a day, enjoying 100% privacy and recurring profits.",
  affiliateUrl = AFFILIATE_LINK,
  midCtaText = "Lock In Your Done-For-You AI Portfolio",
  midCtaSubtext = "Backed by 24-Hour Handover Protocol & Dedicated Implementation",
  workflowTitle = "The 24-Hour Automated Execution Architecture",
  workflowSubtitle = "How our turnkey systems eliminate technical bottlenecks from niche selection to high-ticket revenue capture.",
  isDfyDave = false,
  isLinkStack = false,
  isRoom30 = false
} = Astro.props;
---

<section id="breakdown" class="py-16 md:py-24 bg-slate-950">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Introduction -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        Why Traditional Models Fail for {audience}
      </h2>
      <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
        {avatarContext}
      </p>
    </div>

    <!-- 2-Column Pain vs Solution -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      
      <!-- Pain Points Column -->
      <div class="rounded-2xl bg-red-950/20 border border-red-900/30 p-8">
        <div class="inline-flex items-center px-3 py-1 rounded-full bg-red-500/10 text-red-400 text-xs font-bold uppercase tracking-wider mb-6">
          The Old DIY Struggle
        </div>
        <h3 class="text-xl font-bold text-white mb-4">What Sucks About Starting from Scratch</h3>
        <ul class="space-y-4">
          {painPoints.map((point) => (
            <li class="flex items-start space-x-3 text-slate-300 text-sm sm:text-base">
              <span class="text-red-400 font-bold text-lg mt-0.5">✕</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Turnkey Solution Column -->
      <div class="rounded-2xl bg-emerald-950/20 border border-emerald-900/30 p-8 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>
        <div class="inline-flex items-center px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-6">
          {solutionBadge}
        </div>
        <h3 class="text-xl font-bold text-white mb-4">{solutionTitle}</h3>
        <ul class="space-y-4">
          {keyBenefits.map((benefit) => (
            <li class="flex items-start space-x-3 text-slate-200 text-sm sm:text-base font-medium">
              <span class="text-emerald-400 font-bold text-lg mt-0.5">✓</span>
              <span>{benefit}</span>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Workflow Section -->
    <div class="mb-16">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <h3 class="text-xl sm:text-2xl font-bold text-white mb-2">
          {workflowTitle}
        </h3>
        <p class="text-slate-400 text-sm">
          {workflowSubtitle}
        </p>
      </div>

      {isDfyDave ? (
        <!-- DFY Dave 4-Step Asset Handover Architecture -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 flex flex-col justify-between shadow-xl">
            <div>
              <div class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-2">Step 01</div>
              <h4 class="text-base font-bold text-white mb-2">Asset Audit & Verification</h4>
              <p class="text-xs text-slate-400 leading-relaxed">
                Channels audited for zero strikes, organic watch time, and confirmed active YPP or TikTok Creator Rewards standing.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-800/80 text-[11px] text-slate-500">
              Clean algorithmic status guaranteed
            </div>
          </div>

          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 flex flex-col justify-between shadow-xl">
            <div>
              <div class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-2">Step 02</div>
              <h4 class="text-base font-bold text-white mb-2">Ownership Handover</h4>
              <p class="text-xs text-slate-400 leading-relaxed">
                Transferred safely via official Google Brand Account protocol or direct credential migration with zero password sharing.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-800/80 text-[11px] text-slate-500">
              Primary Owner status granted
            </div>
          </div>

          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 flex flex-col justify-between shadow-xl">
            <div>
              <div class="text-xs font-bold uppercase tracking-widest text-teal-400 mb-2">Step 03</div>
              <h4 class="text-base font-bold text-white mb-2">AdSense & Payout Link</h4>
              <p class="text-xs text-slate-400 leading-relaxed">
                Directly connect your personal or corporate LLC AdSense account to receive 100% of future earnings directly to your bank.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-800/80 text-[11px] text-slate-500">
              Direct monthly bank deposits
            </div>
          </div>

          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 flex flex-col justify-between shadow-xl">
            <div>
              <div class="text-xs font-bold uppercase tracking-widest text-teal-400 mb-2">Step 04</div>
              <h4 class="text-base font-bold text-white mb-2">Hands-Off Production</h4>
              <p class="text-xs text-slate-400 leading-relaxed">
                Publish done-for-you long-form videos or AI reels to generate compound AdSense, TikTok Shop, or affiliate royalties.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-800/80 text-[11px] text-slate-500">
              Scalable hands-off compounding
            </div>
          </div>
        </div>
      ) : isLinkStack ? (
        <!-- LinkStack 4-Step Zero-Friction Creator Commerce Protocol -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 flex flex-col justify-between shadow-xl">
            <div>
              <div class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-2">Step 01</div>
              <h4 class="text-base font-bold text-white mb-2">Instant Storefront Setup</h4>
              <p class="text-xs text-slate-400 leading-relaxed">
                Claim your creator handle, customize your mobile theme, and link your Stripe account for instant direct payouts in under 3 minutes.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-800/80 text-[11px] text-slate-500">
              Zero coding • Free core tier available
            </div>
          </div>

          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 flex flex-col justify-between shadow-xl">
            <div>
              <div class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-2">Step 02</div>
              <h4 class="text-base font-bold text-white mb-2">Digital Product & Lead Host</h4>
              <p class="text-xs text-slate-400 leading-relaxed">
                Upload PDFs, guides, video modules, or free opt-in lead magnets with automated file delivery and zero third-party hosting costs.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-800/80 text-[11px] text-slate-500">
              Automated delivery & list building
            </div>
          </div>

          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 flex flex-col justify-between shadow-xl">
            <div>
              <div class="text-xs font-bold uppercase tracking-widest text-cyan-400 mb-2">Step 03</div>
              <h4 class="text-base font-bold text-white mb-2">Automated DM Funnels</h4>
              <p class="text-xs text-slate-400 leading-relaxed">
                Set up automated comment-to-DM triggers on Instagram and TikTok. Commenters instantly receive checkout and download links in their DMs.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-800/80 text-[11px] text-slate-500">
              Official Meta Tech Provider integration
            </div>
          </div>

          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 flex flex-col justify-between shadow-xl">
            <div>
              <div class="text-xs font-bold uppercase tracking-widest text-cyan-400 mb-2">Step 04</div>
              <h4 class="text-base font-bold text-white mb-2">Smart App Routing & 0% Fee</h4>
              <p class="text-xs text-slate-400 leading-relaxed">
                Links open directly in native YouTube and Amazon apps rather than buggy in-app browsers, preventing drop-offs and maximizing earnings.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-800/80 text-[11px] text-slate-500">
              Direct Stripe payouts • 0% platform fee option
            </div>
          </div>
        </div>
      ) : isRoom30 ? (
        <!-- Standard Room30 Workflow Diagram (Strictly shown only on Room30 AI persona pages) -->
        <div class="rounded-2xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-900/50">
          <img
            src="/images/dfy-ai-system-workflow.webp"
            alt="Step-by-step workflow diagram illustrating the 24-hour setup of automated faceless video channels and script-to-video production"
            width="1376"
            height="768"
            class="w-full h-auto object-cover rounded-2xl"
            loading="lazy"
            decoding="async"
          />
        </div>
      ) : null}
    </div>

    <!-- Before / After Transformation Grid -->
    <div class="rounded-2xl bg-slate-900/80 border border-slate-800 p-8 sm:p-10 mb-16">
      <h3 class="text-xl sm:text-2xl font-bold text-white text-center mb-8">
        Your Transformation
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-sm sm:text-base">
        <div class="space-y-3 p-4 rounded-xl bg-slate-950/50 border border-slate-800/80">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500">{beforeBadge}</span>
          <p class="text-slate-300 italic">"{beforeQuote}"</p>
        </div>
        <div class="space-y-3 p-4 rounded-xl bg-emerald-950/30 border border-emerald-800/40">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">{afterBadge}</span>
          <p class="text-emerald-200 font-medium">"{afterQuote}"</p>
        </div>
      </div>
    </div>

    <!-- Mid-Page Conversion Trigger -->
    <div class="text-center">
      <a
        href={affiliateUrl}
        class="inline-flex items-center justify-center px-8 py-4 text-base font-bold rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 hover:from-emerald-400 hover:to-teal-400 transition-all shadow-xl shadow-emerald-500/20 active:scale-95"
      >
        <span>{midCtaText}</span>
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
      <p class="text-xs text-slate-500 mt-3">{midCtaSubtext}</p>
    </div>

  </div>
</section>
