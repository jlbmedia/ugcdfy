---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND_NAME } from '../data/pages';

const title = `Contact Us | Editorial Desk & Inquiries - ${BRAND_NAME}`;
const description = "Get in touch with the UGC DFY editorial and audit team for reviews, questions, or corrections. Contact our dedicated support desk directly via email.";

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Contact Us", url: "/contact/" }
];

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": `Contact ${BRAND_NAME}`,
  "description": description,
  "mainEntity": {
    "@type": "Organization",
    "name": BRAND_NAME,
    "url": "https://ugcdfy.com",
    "email": "contact@ugcdfy.com",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "Customer Support",
      "email": "contact@ugcdfy.com",
      "availableLanguage": "English"
    }
  }
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/contact/"
  breadcrumbs={breadcrumbs}
  schemaData={contactSchema}
>
  <div class="py-16 md:py-24 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumbs -->
    <nav class="mb-8 flex items-center space-x-2 text-xs text-slate-400">
      <a href="/" class="hover:text-brand-400 transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-200">Contact Us</span>
    </nav>

    <!-- Header Section (Strictly 1 H1) -->
    <header class="mb-12 border-b border-slate-800 pb-10">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>Editorial & Reader Support</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight mb-6">
        Contact UGC DFY
      </h1>
      <p class="text-lg sm:text-xl text-slate-300 leading-relaxed font-normal">
        We welcome inquiries from creators, media investors, and automation tool developers. Reach out to our central communication desk.
      </p>
    </header>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      <!-- General Inquiries -->
      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-400 text-lg mb-4">
            ✉️
          </div>
          <h2 class="text-lg font-bold text-white mb-2">Editorial & Reader Support</h2>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            For general feedback, editorial corrections, or specific questions about our published audits, email our team directly.
          </p>
        </div>
        <div class="pt-4 border-t border-slate-800">
          <a 
            href="mailto:contact@ugcdfy.com" 
            class="inline-flex items-center text-sm font-bold text-brand-400 hover:text-brand-300 transition-colors"
          >
            contact@ugcdfy.com →
          </a>
        </div>
      </div>

      <!-- Vendor / Audit Submission -->
      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-accent-500/10 border border-accent-500/20 flex items-center justify-center text-accent-400 text-lg mb-4">
            🔍
          </div>
          <h2 class="text-lg font-bold text-white mb-2">System Audit Submissions</h2>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Are you the creator of an AI persona pipeline or turnkey media system? Submit your platform for independent scorecard review.
          </p>
        </div>
        <div class="pt-4 border-t border-slate-800">
          <span class="text-xs text-slate-400">Response SLA: 24–48 Business Hours</span>
        </div>
      </div>
    </div>

    <!-- Communication SLA Guidelines -->
    <div class="p-8 rounded-2xl bg-slate-900/40 border border-slate-800 space-y-4 text-slate-300 text-sm leading-relaxed">
      <h2 class="text-xl font-bold text-white">Guidelines for Fast Assistance</h2>
      <ul class="list-disc pl-5 space-y-2 text-slate-400 text-xs sm:text-sm">
        <li><strong>Factual Corrections:</strong> If a vendor alters pricing tiers, guarantees, or deliverables, send documentation to <a href="mailto:contact@ugcdfy.com" class="text-brand-400 hover:underline">contact@ugcdfy.com</a>. Our editors update review articles within 24 hours.</li>
        <li><strong>No Sponsored Endorsements:</strong> We decline requests for paid positive reviews. All scorecards reflect objective data and user protections.</li>
        <li><strong>Support Availability:</strong> Inquiries are reviewed Monday through Friday.</li>
      </ul>
    </div>
  </div>
</BaseLayout>
