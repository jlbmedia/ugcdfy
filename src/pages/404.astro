---
import BaseLayout from '../layouts/BaseLayout.astro';
import { HUBS } from '../data/pages';

const title = "Page Not Found (404) | UGC DFY";
const description = "The requested page could not be found. Explore our directory of turnkey AI influencer systems, faceless channels, and verified reviews.";
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/404/"
  noindex={true}
>
  <div class="min-h-[70vh] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl w-full text-center">
      
      <!-- 404 Badge -->
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs sm:text-sm font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-rose-400 animate-pulse"></span>
        <span>HTTP Status 404 • Page Not Found</span>
      </div>

      <!-- Main Heading -->
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight mb-4">
        Looking for a Turnkey Asset?
      </h1>

      <p class="text-base sm:text-lg text-slate-300 max-w-xl mx-auto mb-8">
        The link you followed has either moved or no longer exists. Browse our verified categories below to find turnkey AI influencer systems and faceless media assets:
      </p>

      <!-- Category Navigation Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left mb-10">
        <a
          href="/ai-influencers/"
          class="p-4 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-emerald-500/50 hover:bg-slate-900 transition-all group"
        >
          <div class="text-emerald-400 font-bold text-sm mb-1 group-hover:translate-x-0.5 transition-transform">
            AI Influencers →
          </div>
          <p class="text-xs text-slate-400">
            Virtual persona generators and automated creator portfolios.
          </p>
        </a>

        <a
          href="/faceless-automation/"
          class="p-4 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-emerald-500/50 hover:bg-slate-900 transition-all group"
        >
          <div class="text-emerald-400 font-bold text-sm mb-1 group-hover:translate-x-0.5 transition-transform">
            Faceless Automation →
          </div>
          <p class="text-xs text-slate-400">
            Turnkey YouTube and TikTok video systems with zero filming.
          </p>
        </a>

        <a
          href="/ai-income-systems/"
          class="p-4 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-emerald-500/50 hover:bg-slate-900 transition-all group"
        >
          <div class="text-emerald-400 font-bold text-sm mb-1 group-hover:translate-x-0.5 transition-transform">
            AI Income Systems →
          </div>
          <p class="text-xs text-slate-400">
            Hands-off digital asset portfolios and monetization models.
          </p>
        </a>

        <a
          href="/reviews/"
          class="p-4 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-emerald-500/50 hover:bg-slate-900 transition-all group"
        >
          <div class="text-emerald-400 font-bold text-sm mb-1 group-hover:translate-x-0.5 transition-transform">
            Audits & Reviews →
          </div>
          <p class="text-xs text-slate-400">
            Independent evaluations of Room30 and DFY Dave systems.
          </p>
        </a>
      </div>

      <!-- Return Home Button -->
      <a
        href="/"
        class="inline-flex items-center justify-center px-8 py-3.5 text-sm font-bold rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 hover:from-emerald-400 hover:to-teal-400 transition-all shadow-lg shadow-emerald-500/20 active:scale-95"
      >
        <span>Return to Homepage</span>
      </a>

    </div>
  </div>
</BaseLayout>
