---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND_NAME } from '../data/pages';

const title = `Affiliate Disclosure & Earnings Disclaimer - ${BRAND_NAME}`;
const description = "Read the official UGC DFY FTC affiliate disclosure. Learn how we maintain editorial independence while earning affiliate partner referral commissions.";

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Affiliate Disclosure", url: "/affiliate-disclosure/" }
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/affiliate-disclosure/"
  breadcrumbs={breadcrumbs}
>
  <div class="py-16 md:py-24 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumbs -->
    <nav class="mb-8 flex items-center space-x-2 text-xs text-slate-400">
      <a href="/" class="hover:text-brand-400 transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-200">Affiliate Disclosure</span>
    </nav>

    <!-- Header Section (Strictly 1 H1) -->
    <header class="mb-12 border-b border-slate-800 pb-10">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>FTC Compliance (16 CFR Part 255)</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight mb-6">
        Affiliate Disclosure & Earnings Disclaimer
      </h1>
      <p class="text-lg sm:text-xl text-slate-300 leading-relaxed font-normal">
        We believe in full transparency with our readers. In compliance with the Federal Trade Commission (FTC), this document explains our financial relationships with product vendors and services.
      </p>
    </header>

    <!-- Content Body -->
    <div class="prose prose-invert max-w-none space-y-10 text-slate-300 leading-relaxed text-base">
      
      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-white tracking-tight">1. FTC Compliance Notice</h2>
        <p>
          Throughout <strong>UGC DFY</strong> (<a href="https://ugcdfy.com" class="text-brand-400 hover:underline">ugcdfy.com</a>), you will encounter links to third-party tools, digital asset sellers, and done-for-you systems. You should assume that we have an affiliate relationship with these providers and may receive financial compensation when you make a purchase through our links.
        </p>
        <p>
          This referral compensation comes at <strong>no extra cost to you</strong>. In many cases, our partner agreements secure exclusive bonuses, reduced introductory pricing, or priority onboarding for our readers.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-white tracking-tight">2. Primary Affiliate Partnerships</h2>
        <p>
          Our site reviews and refers users to select platforms, including:
        </p>
        <div class="space-y-3 not-prose my-6">
          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <span class="font-bold text-white text-sm">Room30 (Room30.ai)</span>
              <p class="text-xs text-slate-400">Referral commissions on AI influencer system audits, done-for-you model packages, and founder immersions.</p>
            </div>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-brand-500/10 text-brand-400 border border-brand-500/20 whitespace-nowrap">Tiered Commission</span>
          </div>

          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <span class="font-bold text-white text-sm">Soldi.ai / DFY Dave</span>
              <p class="text-xs text-slate-400">Referral bounties on pre-monetized YouTube channels, TikTok Creator Rewards accounts, and video packs.</p>
            </div>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-accent-500/10 text-accent-400 border border-accent-500/20 whitespace-nowrap">Asset Bounty</span>
          </div>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-white tracking-tight">3. Objective Review Philosophy</h2>
        <p>
          Our editorial team evaluates tools with total objectivity. If a system exhibits defects—such as poor character consistency in virtual models, account transfer delays, or low RPM performance—we document those shortcomings in our comparison matrices.
        </p>
        <p>
          We do not accept paid insertions or sponsor-controlled copy. Every review verdict represents our team's honest assessment.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-white tracking-tight">4. Digital Media Earnings Disclaimer</h2>
        <p>
          Any references to revenue metrics, YouTube AdSense RPMs, TikTok Creator Rewards earnings, or sponsorship fees mentioned on UGC DFY represent theoretical estimates or vendor-reported case studies. <strong>They are not income guarantees.</strong>
        </p>
        <p>
          Building and operating automated media channels or virtual creators involves market uncertainty, platform policy enforcement, and execution effort. Individual results depend on skill, consistency, audience demand, and external algorithmic factors.
        </p>
      </section>

    </div>
  </div>
</BaseLayout>
