---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { HUBS, SPOKES, AFFILIATE_LINK, type HubPage } from '../../data/pages';

export async function getStaticPaths() {
  return Object.values(HUBS).map((hub) => ({
    params: { category: hub.slug },
    props: { hub }
  }));
}

interface Props {
  hub: HubPage;
}

const { hub } = Astro.props;
const childSpokes = SPOKES.filter((s) => s.category === hub.slug);

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: hub.name, url: `/${hub.slug}/` }
];

// Contextual Hub CTA
let hubCtaText = "Explore Room30 Turnkey Portfolio →";
let hubCtaUrl = AFFILIATE_LINK;

if (hub.slug === "faceless-automation") {
  hubCtaText = "Explore Faceless Video & Monetized Systems →";
  hubCtaUrl = "/reviews/room30-vs-dfy-dave/";
} else if (hub.slug === "reviews") {
  hubCtaText = "Compare Verified Systems & Scorecards →";
  hubCtaUrl = "/reviews/room30-vs-dfy-dave/";
}
---

<BaseLayout
  title={hub.title}
  description={hub.metaDescription}
  breadcrumbs={breadcrumbs}
>
  <section class="py-16 md:py-24 bg-gradient-to-b from-slate-900 to-slate-950 border-b border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs sm:text-sm font-semibold mb-6">
        <span>Category Hub • Comprehensive Directory</span>
      </div>

      <!-- Single H1 per page -->
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-6">
        {hub.h1}
      </h1>

      <p class="text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto mb-8 leading-relaxed">
        {hub.description}
      </p>

      {hub.slug === "reviews" ? (
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/reviews/room30-review/"
            class="w-full sm:w-auto px-6 py-3.5 text-sm sm:text-base font-bold rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 hover:from-emerald-400 hover:to-teal-400 transition-all shadow-xl active:scale-95"
          >
            Room30 AI Portfolio Audit →
          </a>
          <a
            href="/reviews/dfy-dave-monetized-youtube-channel/"
            class="w-full sm:w-auto px-6 py-3.5 text-sm sm:text-base font-bold rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-all shadow-md active:scale-95"
          >
            DFY Dave Monetized Assets Audit →
          </a>
        </div>
      ) : hub.slug === "faceless-automation" ? (
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={AFFILIATE_LINK}
            class="w-full sm:w-auto px-6 py-3.5 text-sm sm:text-base font-bold rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 hover:from-emerald-400 hover:to-teal-400 transition-all shadow-xl active:scale-95"
          >
            Explore Room30 AI Video Systems →
          </a>
          <a
            href="/go/dfy-youtube"
            class="w-full sm:w-auto px-6 py-3.5 text-sm sm:text-base font-bold rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-all shadow-md active:scale-95"
          >
            Acquire DFY Dave Monetized Channels →
          </a>
        </div>
      ) : (
        <div class="inline-flex items-center justify-center gap-4">
          <a
            href={hubCtaUrl}
            class="px-8 py-3.5 text-base font-bold rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 hover:from-emerald-400 hover:to-teal-400 transition-all shadow-xl active:scale-95"
          >
            {hubCtaText}
          </a>
        </div>
      )}

      {hub.slug === "reviews" && (
        <div class="mt-12 max-w-4xl mx-auto rounded-2xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-950">
          <div class="p-6 bg-slate-900/60 border-b border-slate-800 text-center">
            <span class="text-xs uppercase tracking-widest text-emerald-400 font-bold">Comprehensive Multi-System Directory</span>
            <h3 class="text-lg sm:text-xl font-bold text-white mt-1">Comparing Room30, DFY Dave & LinkStack Creator Systems</h3>
            <p class="text-xs text-slate-400 mt-1">Reviewing verification audits, delivery SLAs, and verified creator returns across 2026 digital asset and storefront platforms.</p>
          </div>
          <div class="p-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-left">
            <div class="p-4 rounded-xl bg-slate-900/80 border border-slate-800">
              <div class="flex items-center justify-between mb-2">
                <strong class="text-white text-sm">Room30 AI Systems</strong>
                <span class="text-xs font-bold text-emerald-400">Score: 9.4/10</span>
              </div>
              <p class="text-xs text-slate-400 mb-3">Custom photorealistic AI influencer portfolios, script-to-video pipelines, and brand partnerships.</p>
              <a href="/reviews/room30-review/" class="text-xs font-bold text-emerald-400 hover:underline">Read Full Audit →</a>
            </div>
            <div class="p-4 rounded-xl bg-slate-900/80 border border-slate-800">
              <div class="flex items-center justify-between mb-2">
                <strong class="text-white text-sm">DFY Dave Media Assets</strong>
                <span class="text-xs font-bold text-teal-400">Score: 9.4/10</span>
              </div>
              <p class="text-xs text-slate-400 mb-3">Turnkey monetized YouTube & TikTok accounts with day-one Google AdSense and Creator Rewards.</p>
              <a href="/reviews/dfy-dave-monetized-youtube-channel/" class="text-xs font-bold text-teal-400 hover:underline">Read Full Audit →</a>
            </div>
            <div class="p-4 rounded-xl bg-slate-900/80 border border-slate-800">
              <div class="flex items-center justify-between mb-2">
                <strong class="text-white text-sm">LinkStack Storefront</strong>
                <span class="text-xs font-bold text-cyan-400">Score: 9.6/10</span>
              </div>
              <p class="text-xs text-slate-400 mb-3">0% software fee creator storefront, direct Stripe checkout, and automated Instagram DM funnels.</p>
              <a href="/reviews/linkstack-review/" class="text-xs font-bold text-cyan-400 hover:underline">Read Full Audit →</a>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Child Spokes Grid -->
  <section class="py-16 bg-slate-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-white">
            Specialized Guides & Use Cases
          </h2>
          <p class="text-slate-400 text-sm">
            Select your specific situation below to view tailored blueprints and unit economics.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {childSpokes.map((spoke) => (
          <a
            href={`${spoke.categoryPath}${spoke.slug}/`}
            class="group rounded-2xl border border-slate-800 bg-slate-900/50 p-6 hover:border-emerald-500/50 hover:bg-slate-900 transition-all flex flex-col justify-between"
          >
            <div>
              <span class="inline-block px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-400 text-xs font-semibold mb-3">
                {spoke.badge}
              </span>
              <h3 class="text-lg font-bold text-white group-hover:text-emerald-400 transition-colors mb-2">
                {spoke.h1}
              </h3>
              <p class="text-xs sm:text-sm text-slate-400 line-clamp-3 mb-4">
                {spoke.heroHeadline}. {spoke.heroSubheadline}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs font-semibold text-emerald-400">
              <span>View Full Strategy</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
