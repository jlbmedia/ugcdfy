---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboveTheFoldHero from '../../components/AboveTheFoldHero.astro';
import FeaturesBreakdown from '../../components/FeaturesBreakdown.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import StickyCTA from '../../components/StickyCTA.astro';
import { SPOKES, HUBS, type SpokePage } from '../../data/pages';

export async function getStaticPaths() {
  return SPOKES.map((spoke) => ({
    params: {
      category: spoke.category,
      slug: spoke.slug
    },
    props: { spoke }
  }));
}

interface Props {
  spoke: SpokePage;
}

const { spoke } = Astro.props;
const hub = HUBS[spoke.category];

const isDfyOffer = spoke.slug === "room30-done-for-you-service";
const isVipImmersion = spoke.slug === "three-days-with-greg";

// DFY Dave spokes
const isDfyDaveYouTube = spoke.slug === "dfy-dave-monetized-youtube-channel" || spoke.slug === "monetized-channels-for-busy-executives";
const isDfyDaveTikTok = spoke.slug === "dfy-dave-monetized-tiktok-account" || spoke.slug === "monetized-tiktok-for-dropshippers";
const isDfyDaveAmazon = spoke.slug === "dfy-dave-amazon-affiliate-website";
const isDfyDaveVideos = spoke.slug === "dfy-dave-done-for-you-youtube-videos";
const isDfyDaveReview = spoke.slug === "dfy-dave-review";
const isRoom30VsDfyDave = spoke.slug === "room30-vs-dfy-dave";

const isDfyDavePage = isDfyDaveYouTube || isDfyDaveTikTok || isDfyDaveAmazon || isDfyDaveVideos || isDfyDaveReview || isRoom30VsDfyDave;

// LinkStack spokes
const isLinkStackReview = spoke.slug === "linkstack-review";
const isStanStoreAlternative = spoke.slug === "stan-store-alternative";
const isLinkStackPage = isLinkStackReview || isStanStoreAlternative;

const isRoom30Review = spoke.category === "reviews" && !isDfyDavePage && !isLinkStackPage;

let customAffiliateUrl: string | undefined;
let customCtaText: string | undefined;
let customStickyText = `Get your custom ${spoke.audience} AI portfolio built in 24 hours.`;

if (isVipImmersion) {
  customAffiliateUrl = "/go/three-days";
  customCtaText = "Apply for Private 1-on-1 Immersion";
  customStickyText = "Apply for 1 of 4 private founder slots: 3 days in-person with Greg Cooke.";
} else if (isDfyOffer) {
  customAffiliateUrl = "/go/dfy-influencer";
  customCtaText = "Explore 100% Done-For-You Pre-Made Business";
  customStickyText = "Get your 10,000-follower AI influencer & 90-day content stack built turnkey.";
} else if (isDfyDaveYouTube) {
  customAffiliateUrl = "/go/dfy-youtube";
  customCtaText = "Check Monetized Channel Availability →";
  customStickyText = "Acquire a turnkey YouTube channel enrolled in YPP with instant AdSense.";
} else if (isDfyDaveTikTok) {
  customAffiliateUrl = "/go/dfy-tiktok";
  customCtaText = "Claim Monetized TikTok Account →";
  customStickyText = "Access US/UK monetized TikTok accounts eligible for Creator Rewards.";
} else if (isDfyDaveAmazon) {
  customAffiliateUrl = "/go/dfy-amazon";
  customCtaText = "Launch Turnkey Amazon Affiliate Site →";
  customStickyText = "Deploy pre-built Amazon review blogs loaded with SEO buyer guides.";
} else if (isDfyDaveVideos) {
  customAffiliateUrl = "/go/dfy-videos";
  customCtaText = "Order Done-For-You Video Package →";
  customStickyText = "Get 10, 20, or 30 edited faceless YouTube videos delivered turnkey.";
} else if (isDfyDaveReview) {
  customAffiliateUrl = "/go/dfy-dave";
  customCtaText = "Explore DFY Dave Platform Catalog →";
  customStickyText = "Audit Dave Nick's complete catalog of turnkey monetized digital assets.";
} else if (isRoom30VsDfyDave) {
  customAffiliateUrl = "/go/dfy-youtube";
  customCtaText = "Compare Turnkey Monetization Solutions →";
  customStickyText = "Combine Room30 AI video systems with DFY Dave monetized channels.";
} else if (isLinkStackReview) {
  customAffiliateUrl = "/go/linkstack";
  customCtaText = "Claim Free LinkStack Account →";
  customStickyText = "Launch your free creator storefront, direct DMs & checkout in under 3 minutes.";
} else if (isStanStoreAlternative) {
  customAffiliateUrl = "/go/linkstack-compare";
  customCtaText = "Switch to LinkStack Free →";
  customStickyText = "Replace $348/yr Stan Store subscriptions with LinkStack's 0% fee creator engine.";
}

// Global Layout CTAs & Announcement Bar Context
let layoutAnnouncementText = "🚀 2026 Batch Open: Get Your Turnkey Faceless AI Influencer Portfolio Deployed in 24 Hours.";
let layoutAnnouncementCtaText = "Claim Verified Access →";
let layoutAnnouncementCtaUrl = "/go/dfy";
let layoutHeaderCtaText = "Explore Room30 Offer";
let layoutHeaderCtaUrl = "/go/dfy";

if (isVipImmersion) {
  layoutAnnouncementText = "👑 Private Founder Immersion: 3 Days In-Person with Gregory Cooke (Strictly 4 Clients/Year).";
  layoutAnnouncementCtaText = "Apply for Immersion →";
  layoutAnnouncementCtaUrl = "/go/three-days";
  layoutHeaderCtaText = "Apply for Immersion";
  layoutHeaderCtaUrl = "/go/three-days";
} else if (isDfyOffer) {
  layoutAnnouncementText = "⚡ 100% Done-For-You Pre-Made Business: 10k Follower AI Influencer & 90-Day Content Stack.";
  layoutAnnouncementCtaText = "View DFY Packages →";
  layoutAnnouncementCtaUrl = "/go/dfy-influencer";
  layoutHeaderCtaText = "Explore DFY Packages";
  layoutHeaderCtaUrl = "/go/dfy-influencer";
} else if (isDfyDavePage) {
  layoutAnnouncementText = "⚡ Turnkey Media Assets: Pre-Monetized Channels & Done-For-You Production Ready for Handover.";
  layoutAnnouncementCtaText = "Claim Verified Asset →";
  layoutAnnouncementCtaUrl = customAffiliateUrl || "/go/dfy-dave";
  layoutHeaderCtaText = "Explore DFY Dave Assets";
  layoutHeaderCtaUrl = customAffiliateUrl || "/go/dfy-dave";
} else if (isLinkStackPage) {
  layoutAnnouncementText = "✨ The Modern Creator Storefront: Replace Stan Store & ManyChat Free with LinkStack.";
  layoutAnnouncementCtaText = "Claim Free Account →";
  layoutAnnouncementCtaUrl = "/go/linkstack-free";
  layoutHeaderCtaText = "Get LinkStack Free";
  layoutHeaderCtaUrl = "/go/linkstack-free";
}

// Tailored Hero Authority Signals
let authoritySignals = [
  "100% Done-For-You in 24h",
  "Zero Camera or Face Required",
  "32,000+ Enrolled Worldwide",
  "As Seen on Forbes & Entrepreneur"
];

if (isDfyDaveYouTube) {
  authoritySignals = [
    "Turnkey Handover in 24–48h",
    "Active YPP & AdSense Enrolled",
    "100% Google Brand Account Transfer",
    "24/7 Global Onboarding Support"
  ];
} else if (isDfyDaveTikTok) {
  authoritySignals = [
    "10,000+ Verified Followers",
    "TikTok Shop Affiliate Eligible",
    "US / UK Creator Rewards Active",
    "24/7 Dedicated Handover Team"
  ];
} else if (isDfyDaveAmazon) {
  authoritySignals = [
    "50+ SEO Buyer Guides Pre-Loaded",
    "Turnkey WordPress Deployment",
    "Amazon Associates TOS Compliant",
    "100% Passive Fulfillment Model"
  ];
} else if (isDfyDaveVideos) {
  authoritySignals = [
    "10, 20, or 30 Complete 1080p Videos",
    "Script, Voice, Edit & Thumbnail Included",
    "Engineered for High Retention & CTR",
    "Batch Delivered Ready to Upload"
  ];
} else if (isDfyDaveReview) {
  authoritySignals = [
    "Dave Nick Media Ecosystem",
    "1,000+ Digital Assets Delivered",
    "Verified Primary Owner Transfers",
    "24/7 Customer Support Guarantee"
  ];
} else if (isRoom30VsDfyDave) {
  authoritySignals = [
    "Objective Independent System Audit",
    "Greg Cooke vs. Dave Nick Frameworks",
    "Head-to-Head Pricing & Unit Economics",
    "Hybrid High-ROI Workflow Revealed"
  ];
} else if (isLinkStackReview) {
  authoritySignals = [
    "100% Free Forever Core Tier",
    "Instant Stripe Direct Payouts",
    "Native DM Automation Included",
    "Replace Stan Store + ManyChat"
  ];
} else if (isStanStoreAlternative) {
  authoritySignals = [
    "Save $348 to $1,188/Year",
    "0% Transaction Fee Option",
    "Built-in DM Funnels & Storefront",
    "3-Minute Migration Protocol"
  ];
}

// Comparison Table Variant
type CompVariant = "room30" | "dfy-dave-youtube" | "dfy-dave-tiktok" | "dfy-dave-amazon" | "dfy-dave-videos" | "dfy-dave-platform" | "room30-vs-dfy-dave" | "linkstack" | "stan-store-vs-linkstack";
let comparisonVariant: CompVariant = "room30";

if (isDfyDaveYouTube) {
  comparisonVariant = "dfy-dave-youtube";
} else if (isDfyDaveTikTok) {
  comparisonVariant = "dfy-dave-tiktok";
} else if (isDfyDaveAmazon) {
  comparisonVariant = "dfy-dave-amazon";
} else if (isDfyDaveVideos) {
  comparisonVariant = "dfy-dave-videos";
} else if (isDfyDaveReview) {
  comparisonVariant = "dfy-dave-platform";
} else if (isRoom30VsDfyDave) {
  comparisonVariant = "room30-vs-dfy-dave";
} else if (isLinkStackReview) {
  comparisonVariant = "linkstack";
} else if (isStanStoreAlternative) {
  comparisonVariant = "stan-store-vs-linkstack";
}

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: spoke.categoryName, url: spoke.categoryPath },
  { name: spoke.h1, url: `${spoke.categoryPath}${spoke.slug}/` }
];

// Related spokes for internal linking mesh:
// Strictly isolate DFY Dave and LinkStack spokes from Room30 spokes for maximum offer congruency
const dfyDaveSlugs = [
  "dfy-dave-monetized-youtube-channel",
  "dfy-dave-monetized-tiktok-account",
  "dfy-dave-amazon-affiliate-website",
  "dfy-dave-done-for-you-youtube-videos",
  "dfy-dave-review",
  "room30-vs-dfy-dave",
  "monetized-channels-for-busy-executives",
  "monetized-tiktok-for-dropshippers"
];

const linkStackSlugs = [
  "linkstack-review",
  "stan-store-alternative"
];

let relatedSpokes: SpokePage[];
if (isDfyDavePage) {
  const otherDfySpokes = SPOKES.filter((s) => dfyDaveSlugs.includes(s.slug) && s.slug !== spoke.slug);
  const remainingSpokes = SPOKES.filter((s) => !dfyDaveSlugs.includes(s.slug) && !linkStackSlugs.includes(s.slug) && s.slug !== spoke.slug);
  relatedSpokes = [...otherDfySpokes, ...remainingSpokes].slice(0, 3);
} else if (isLinkStackPage) {
  const partnerLinkStackSpoke = SPOKES.filter((s) => linkStackSlugs.includes(s.slug) && s.slug !== spoke.slug);
  const complementarySpokes = SPOKES.filter((s) => s.slug === "faceless-ugc-for-course-creators" || s.slug === "room30-done-for-you-service");
  relatedSpokes = [...partnerLinkStackSpoke, ...complementarySpokes].slice(0, 3);
} else {
  const otherRoom30Spokes = SPOKES.filter((s) => !dfyDaveSlugs.includes(s.slug) && !linkStackSlugs.includes(s.slug) && s.slug !== spoke.slug && s.category === spoke.category);
  const remainingRoom30Spokes = SPOKES.filter((s) => !dfyDaveSlugs.includes(s.slug) && !linkStackSlugs.includes(s.slug) && s.slug !== spoke.slug && s.category !== spoke.category);
  relatedSpokes = [...otherRoom30Spokes, ...remainingRoom30Spokes].slice(0, 3);
}

// Dynamic Product / Software Schema for Google SERP
let productSchemaName = "Room30 AI Influencer Portfolio";
let productSchemaPrice = "175.00";
let productSchemaUrl = "https://room30.ai/offer?fpr=joseph65&fp_sid=ugcdfy";

if (isVipImmersion) {
  productSchemaName = "Room30 Three Days With Greg Founder Immersion";
  productSchemaPrice = "100000.00";
  productSchemaUrl = "https://room30.ai/three-days-with-greg?fpr=joseph65&fp_sid=ugcdfy";
} else if (isDfyOffer) {
  productSchemaName = "Room30 Done-For-You Pre-Made Business";
  productSchemaPrice = "4997.00";
  productSchemaUrl = "https://room30.ai/dfy-ai-influencer?fpr=joseph65&fp_sid=ugcdfy";
} else if (isDfyDaveYouTube) {
  productSchemaName = "DFY Dave Monetized YouTube Channel";
  productSchemaPrice = "695.00";
  productSchemaUrl = "https://dfydave.com/monetization?p=B63B41B5&subid=ugcdfy";
} else if (isDfyDaveTikTok) {
  productSchemaName = "DFY Dave Monetized TikTok Account";
  productSchemaPrice = "795.00";
  productSchemaUrl = "https://www.dfydave.com/tiktok-monetization?p=B63B41B5&subid=ugcdfy";
} else if (isDfyDaveAmazon) {
  productSchemaName = "DFY Dave Turnkey Amazon Affiliate Website";
  productSchemaPrice = "995.00";
  productSchemaUrl = "https://www.dfydave.com/amazon-affiliate-website?p=B63B41B5&subid=ugcdfy";
} else if (isDfyDaveVideos) {
  productSchemaName = "DFY Dave Faceless YouTube Video Production";
  productSchemaPrice = "250.00";
  productSchemaUrl = "https://buy.dfydave.com/dfy-10-long-form-youtube-videos?p=B63B41B5&subid=ugcdfy";
} else if (isDfyDaveReview) {
  productSchemaName = "DFY Dave Digital Asset & Automation Platform";
  productSchemaPrice = "695.00";
  productSchemaUrl = "https://www.dfydave.com/?p=B63B41B5&subid=ugcdfy";
} else if (isLinkStackReview) {
  productSchemaName = "LinkStack Free Creator Storefront & DM Automation";
  productSchemaPrice = "0.00";
  productSchemaUrl = "https://www.linkstack.fyi/?ref=jlb&subid=ugcdfy";
} else if (isStanStoreAlternative) {
  productSchemaName = "LinkStack Stan Store Alternative Platform";
  productSchemaPrice = "0.00";
  productSchemaUrl = "https://www.linkstack.fyi/p/compare?ref=jlb&subid=ugcdfy";
}

const productSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": productSchemaName,
  "operatingSystem": "Cloud-based / Web",
  "applicationCategory": "BusinessApplication",
  "offers": {
    "@type": "Offer",
    "price": productSchemaPrice,
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": productSchemaUrl
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "1420",
    "bestRating": "5",
    "worstRating": "1"
  }
};
---

<BaseLayout
  title={spoke.title}
  description={spoke.metaDescription}
  breadcrumbs={breadcrumbs}
  schemaType="SoftwareApplication"
  schemaData={productSchema}
  announcementText={layoutAnnouncementText}
  announcementCtaText={layoutAnnouncementCtaText}
  announcementCtaUrl={layoutAnnouncementCtaUrl}
  headerCtaText={layoutHeaderCtaText}
  headerCtaUrl={layoutHeaderCtaUrl}
>
  <!-- Above the fold: strictly confirms use case before scrolling -->
  <AboveTheFoldHero
    h1={spoke.h1}
    badge={spoke.badge}
    headline={spoke.heroHeadline}
    subheadline={spoke.heroSubheadline}
    audience={spoke.audience}
    affiliateUrl={customAffiliateUrl}
    ctaText={customCtaText}
    authoritySignals={authoritySignals}
  />

  {isDfyOffer && (
    <section class="py-16 md:py-24 bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 border-b border-slate-800">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-wider mb-4">
            <span>Official Room30 Done-For-You Tier Audit</span>
          </div>
          <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight mb-4">
            Gold ($4,997) vs. Diamond ($9,997) White-Glove Packages
          </h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Unlike self-managed courses or software subscriptions, Room30's Done-For-You service delivers a complete pre-made business with verified follower assets and pre-scheduled content.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          <!-- Gold Tier -->
          <div class="rounded-3xl border border-amber-500/30 bg-gradient-to-b from-slate-900/90 to-slate-950 p-8 flex flex-col justify-between shadow-2xl relative">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-bold uppercase tracking-wider">
                  Gold Package
                </span>
                <span class="text-2xl sm:text-3xl font-black text-white">$4,997 <span class="text-xs text-slate-400 font-normal">USD</span></span>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">Turnkey 1-Persona Pre-Made Business</h3>
              <p class="text-xs sm:text-sm text-slate-400 mb-6">
                Complete AI influencer build with live social accounts, established followings, and 90 days of queued video assets.
              </p>
              <ul class="space-y-3.5 text-xs sm:text-sm text-slate-200 border-t border-slate-800 pt-6">
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>1 Custom AI Influencer Persona:</strong> Face, voice, look, and niche built within 24 hours</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>10,000+ Followers:</strong> Live Instagram & TikTok accounts provisioned with active audiences</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>90 Days of Pre-Scheduled Content:</strong> Full feed posts, reels, carousels, and story sets</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>Automation Stack:</strong> Full prompt library and publishing engine for ongoing operation</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>12 Months of Workshops:</strong> 2-hour weekly live strategic training with Gregory Cooke</span>
                </li>
              </ul>
            </div>
            <div class="mt-8 pt-6 border-t border-slate-800">
              <a
                href="/go/dfy-influencer"
                class="w-full inline-flex items-center justify-center px-6 py-3.5 text-sm font-bold rounded-xl bg-gradient-to-r from-amber-500 to-amber-400 text-slate-950 hover:from-amber-400 hover:to-amber-300 transition-all shadow-lg active:scale-95"
              >
                <span>Apply for Gold Tier ($4,997) →</span>
              </a>
            </div>
          </div>

          <!-- Diamond Tier -->
          <div class="rounded-3xl border border-teal-500/40 bg-gradient-to-b from-slate-900/90 to-slate-950 p-8 flex flex-col justify-between shadow-2xl relative">
            <div class="absolute -top-3 right-6 px-3 py-1 rounded-full bg-teal-500 text-slate-950 text-xs font-black uppercase tracking-wider shadow-md">
              Most Scalable
            </div>
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-3 py-1 rounded-full bg-teal-500/20 text-teal-300 text-xs font-bold uppercase tracking-wider">
                  Diamond Package
                </span>
                <span class="text-2xl sm:text-3xl font-black text-white">$9,997 <span class="text-xs text-slate-400 font-normal">USD</span></span>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">Dual-Persona Multi-Brand Enterprise</h3>
              <p class="text-xs sm:text-sm text-slate-400 mb-6">
                Two complete 10,000-follower AI influencer assets paired with 1:1 dedicated executive Slack & Zoom mentorship.
              </p>
              <ul class="space-y-3.5 text-xs sm:text-sm text-slate-200 border-t border-slate-800 pt-6">
                <li class="flex items-start gap-2.5">
                  <span class="text-teal-400 font-bold">✓</span>
                  <span><strong>Everything in Gold Tier:</strong> Full 90-day content stack and 12-month workshop access</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-teal-400 font-bold">✓</span>
                  <span><strong>Second 10k-Follower AI Influencer:</strong> Double your market presence across two distinct niches</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-teal-400 font-bold">✓</span>
                  <span><strong>Dedicated 1:1 Slack Mentor:</strong> Direct daily communication with Room30 implementation staff</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-teal-400 font-bold">✓</span>
                  <span><strong>Monthly 1:1 Zoom Strategy Calls:</strong> High-level campaign optimization and monetization reviews</span>
                </li>
              </ul>
            </div>
            <div class="mt-8 pt-6 border-t border-slate-800">
              <a
                href="/go/dfy-influencer"
                class="w-full inline-flex items-center justify-center px-6 py-3.5 text-sm font-bold rounded-xl bg-gradient-to-r from-teal-400 to-emerald-400 text-slate-950 hover:from-teal-300 hover:to-emerald-300 transition-all shadow-lg active:scale-95"
              >
                <span>Apply for Diamond Tier ($9,997) →</span>
              </a>
            </div>
          </div>
        </div>

        <div class="text-center">
          <p class="text-xs text-slate-500">
            All builds executed under formal online service agreement with verified Stripe payment processing.
          </p>
        </div>
      </div>
    </section>
  )}

  {isVipImmersion && (
    <section class="py-16 md:py-24 bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 border-b border-slate-800">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-wider mb-4">
            <span>Room30 Founder Tier Audit • Strictly 4 Clients / Year</span>
          </div>
          <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight mb-4">
            Private 1-on-1 In-Person Founder Immersion ($100,000 USD)
          </h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Not a course or group mastermind. Three uninterrupted days with Gregory Cooke at a private European location, building your entire AI persona portfolio, proprietary automation stack, and scaling operations in the room.
          </p>
        </div>

        <!-- 3-Phase Delivery Architecture -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          <!-- Phase 1 -->
          <div class="rounded-2xl border border-slate-800 bg-slate-950/80 p-6 flex flex-col justify-between shadow-xl">
            <div>
              <div class="text-xs font-bold uppercase tracking-widest text-amber-400 mb-2">Phase 01 • Pre-Trip</div>
              <h3 class="text-lg font-bold text-white mb-2">Audit & Concierge Logistics</h3>
              <p class="text-xs sm:text-sm text-slate-400 mb-4">
                Full business, funnel, and traffic intake to map every moving part before arrival, with complete luxury travel coordination.
              </p>
              <ul class="space-y-2 text-xs text-slate-300">
                <li class="flex items-start gap-2"><span class="text-amber-400 font-bold">✓</span><span>Private intake call with Greg's team</span></li>
                <li class="flex items-start gap-2"><span class="text-amber-400 font-bold">✓</span><span>Full audit of funnels, traffic & offers</span></li>
                <li class="flex items-start gap-2"><span class="text-amber-400 font-bold">✓</span><span>Concierge travel & accommodation handled</span></li>
              </ul>
            </div>
