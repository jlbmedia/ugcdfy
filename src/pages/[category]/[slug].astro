---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboveTheFoldHero from '../../components/AboveTheFoldHero.astro';
import FeaturesBreakdown from '../../components/FeaturesBreakdown.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import StickyCTA from '../../components/StickyCTA.astro';
import { SPOKES, HUBS, type SpokePage } from '../../data/pages';

export async function getStaticPaths() {
  return SPOKES.map((spoke) => ({
    params: {
      category: spoke.category,
      slug: spoke.slug
    },
    props: { spoke }
  }));
}

interface Props {
  spoke: SpokePage;
}

const { spoke } = Astro.props;
const hub = HUBS[spoke.category];

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: spoke.categoryName, url: spoke.categoryPath },
  { name: spoke.h1, url: `${spoke.categoryPath}${spoke.slug}/` }
];

// Related spokes for internal linking mesh: prefer same category, fallback to other categories
const categorySpokes = SPOKES.filter((s) => s.category === spoke.category && s.slug !== spoke.slug);
const otherCategorySpokes = SPOKES.filter((s) => s.category !== spoke.category && s.slug !== spoke.slug);
const relatedSpokes = [...categorySpokes, ...otherCategorySpokes].slice(0, 3);

// Product / Software Schema for Google SERP
const productSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Room30 AI Influencer Portfolio",
  "operatingSystem": "Cloud-based / Web",
  "applicationCategory": "BusinessApplication",
  "offers": {
    "@type": "Offer",
    "price": "175.00",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": "https://room30.ai/offer?fpr=joseph65"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "1420",
    "bestRating": "5",
    "worstRating": "1"
  }
};
---

<BaseLayout
  title={spoke.title}
  description={spoke.metaDescription}
  breadcrumbs={breadcrumbs}
  schemaType="SoftwareApplication"
  schemaData={productSchema}
>
  <!-- Above the fold: strictly confirms use case before scrolling -->
  <AboveTheFoldHero
    h1={spoke.h1}
    badge={spoke.badge}
    headline={spoke.heroHeadline}
    subheadline={spoke.heroSubheadline}
    audience={spoke.audience}
  />

  <!-- Pain points, transformation & benefits tailored to this exact avatar -->
  <FeaturesBreakdown
    audience={spoke.audience}
    avatarContext={spoke.avatarContext}
    painPoints={spoke.painPoints}
    keyBenefits={spoke.keyBenefits}
  />

  {spoke.category === "reviews" && (
    <section class="py-12 bg-slate-900/30 border-b border-slate-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">
          Verified Independent Audit & Scorecard
        </h2>
        <p class="text-slate-400 text-sm mb-8">
          Objective evaluation of system delivery, privacy architecture, founder credibility, and unit economics.
        </p>
        <div class="rounded-2xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-950">
          <img
            src="/images/room30-system-audit-scorecard.webp"
            alt="Independent system audit scorecard and verification for Room30 AI Influencer Portfolio showing 9.4 trust score and evaluation metrics"
            width="1376"
            height="768"
            class="w-full h-auto object-cover rounded-2xl"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>
  )}

  <!-- Direct comparison table vs old DIY approaches -->
  <ComparisonTable />

  <!-- FAQ Accordion with rich FAQPage schema markup -->
  <FAQAccordion faqList={spoke.faqList} />

  <!-- Related Spoke Blueprints (Internal Linking Mesh) -->
  <section class="py-16 bg-slate-900/40 border-t border-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-xl sm:text-3xl font-bold text-white tracking-tight mb-2">
          Related AI Portfolios & Use Cases
        </h2>
        <p class="text-slate-400 text-sm">
          Explore specialized turnkey frameworks designed for complementary professions, channels, and business models.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedSpokes.map((rel) => (
          <a
            href={`${rel.categoryPath}${rel.slug}/`}
            class="group rounded-2xl border border-slate-800 bg-slate-950/80 p-6 hover:border-emerald-500/50 hover:bg-slate-900/60 transition-all flex flex-col justify-between shadow-lg"
          >
            <div>
              <span class="inline-block px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-400 text-xs font-semibold mb-3">
                {rel.badge}
              </span>
              <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-emerald-400 transition-colors mb-2">
                {rel.h1}
              </h3>
              <p class="text-xs sm:text-sm text-slate-400 line-clamp-2 mb-4">
                {rel.heroHeadline}
              </p>
            </div>
            <div class="inline-flex items-center text-xs font-semibold text-emerald-400 group-hover:translate-x-1 transition-transform">
              <span>View Blueprint</span>
              <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Fixed bottom conversion anchor -->
  <StickyCTA offerText={`Get your custom ${spoke.audience} AI portfolio built in 24 hours.`} />
</BaseLayout>
