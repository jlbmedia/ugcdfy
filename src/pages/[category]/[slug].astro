---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboveTheFoldHero from '../../components/AboveTheFoldHero.astro';
import FeaturesBreakdown from '../../components/FeaturesBreakdown.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import StickyCTA from '../../components/StickyCTA.astro';
import { SPOKES, HUBS, type SpokePage } from '../../data/pages';

export async function getStaticPaths() {
  return SPOKES.map((spoke) => ({
    params: {
      category: spoke.category,
      slug: spoke.slug
    },
    props: { spoke }
  }));
}

interface Props {
  spoke: SpokePage;
}

const { spoke } = Astro.props;
const hub = HUBS[spoke.category];

const isDfyOffer = spoke.slug === "room30-done-for-you-service";
const customAffiliateUrl = isDfyOffer ? "/go/dfy-influencer" : undefined;
const customCtaText = isDfyOffer ? "Explore 100% Done-For-You Pre-Made Business" : undefined;
const customStickyText = isDfyOffer
  ? "Get your 10,000-follower AI influencer & 90-day content stack built turnkey."
  : `Get your custom ${spoke.audience} AI portfolio built in 24 hours.`;

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: spoke.categoryName, url: spoke.categoryPath },
  { name: spoke.h1, url: `${spoke.categoryPath}${spoke.slug}/` }
];

// Related spokes for internal linking mesh: prefer same category, fallback to other categories
const categorySpokes = SPOKES.filter((s) => s.category === spoke.category && s.slug !== spoke.slug);
const otherCategorySpokes = SPOKES.filter((s) => s.category !== spoke.category && s.slug !== spoke.slug);
const relatedSpokes = [...categorySpokes, ...otherCategorySpokes].slice(0, 3);

// Product / Software Schema for Google SERP
const productSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Room30 AI Influencer Portfolio",
  "operatingSystem": "Cloud-based / Web",
  "applicationCategory": "BusinessApplication",
  "offers": {
    "@type": "Offer",
    "price": "175.00",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": "https://room30.ai/offer?fpr=joseph65"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "1420",
    "bestRating": "5",
    "worstRating": "1"
  }
};
---

<BaseLayout
  title={spoke.title}
  description={spoke.metaDescription}
  breadcrumbs={breadcrumbs}
  schemaType="SoftwareApplication"
  schemaData={productSchema}
>
  <!-- Above the fold: strictly confirms use case before scrolling -->
  <AboveTheFoldHero
    h1={spoke.h1}
    badge={spoke.badge}
    headline={spoke.heroHeadline}
    subheadline={spoke.heroSubheadline}
    audience={spoke.audience}
    affiliateUrl={customAffiliateUrl}
    ctaText={customCtaText}
  />

  {isDfyOffer && (
    <section class="py-16 md:py-24 bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 border-b border-slate-800">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-wider mb-4">
            <span>Official Room30 Done-For-You Tier Audit</span>
          </div>
          <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight mb-4">
            Gold ($4,997) vs. Diamond ($9,997) White-Glove Packages
          </h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Unlike self-managed courses or software subscriptions, Room30's Done-For-You service delivers a complete pre-made business with verified follower assets and pre-scheduled content.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          <!-- Gold Tier -->
          <div class="rounded-3xl border border-amber-500/30 bg-gradient-to-b from-slate-900/90 to-slate-950 p-8 flex flex-col justify-between shadow-2xl relative">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-bold uppercase tracking-wider">
                  Gold Package
                </span>
                <span class="text-2xl sm:text-3xl font-black text-white">$4,997 <span class="text-xs text-slate-400 font-normal">USD</span></span>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">Turnkey 1-Persona Pre-Made Business</h3>
              <p class="text-xs sm:text-sm text-slate-400 mb-6">
                Complete AI influencer build with live social accounts, established followings, and 90 days of queued video assets.
              </p>
              <ul class="space-y-3.5 text-xs sm:text-sm text-slate-200 border-t border-slate-800 pt-6">
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>1 Custom AI Influencer Persona:</strong> Face, voice, look, and niche built within 24 hours</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>10,000+ Followers:</strong> Live Instagram & TikTok accounts provisioned with active audiences</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>90 Days of Pre-Scheduled Content:</strong> Full feed posts, reels, carousels, and story sets</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>Automation Stack:</strong> Full prompt library and publishing engine for ongoing operation</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>12 Months of Workshops:</strong> 2-hour weekly live strategic training with Gregory Cooke</span>
                </li>
              </ul>
            </div>
            <div class="mt-8 pt-6 border-t border-slate-800">
              <a
                href="/go/dfy-influencer"
                class="w-full inline-flex items-center justify-center px-6 py-3.5 text-sm font-bold rounded-xl bg-gradient-to-r from-amber-500 to-amber-400 text-slate-950 hover:from-amber-400 hover:to-amber-300 transition-all shadow-lg active:scale-95"
              >
                <span>Apply for Gold Tier ($4,997) →</span>
              </a>
            </div>
          </div>

          <!-- Diamond Tier -->
          <div class="rounded-3xl border border-teal-500/40 bg-gradient-to-b from-slate-900/90 to-slate-950 p-8 flex flex-col justify-between shadow-2xl relative">
            <div class="absolute -top-3 right-6 px-3 py-1 rounded-full bg-teal-500 text-slate-950 text-xs font-black uppercase tracking-wider shadow-md">
              Most Scalable
            </div>
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-3 py-1 rounded-full bg-teal-500/20 text-teal-300 text-xs font-bold uppercase tracking-wider">
                  Diamond Package
                </span>
                <span class="text-2xl sm:text-3xl font-black text-white">$9,997 <span class="text-xs text-slate-400 font-normal">USD</span></span>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">Dual-Persona Multi-Brand Enterprise</h3>
              <p class="text-xs sm:text-sm text-slate-400 mb-6">
                Two complete 10,000-follower AI influencer assets paired with 1:1 dedicated executive Slack & Zoom mentorship.
              </p>
              <ul class="space-y-3.5 text-xs sm:text-sm text-slate-200 border-t border-slate-800 pt-6">
                <li class="flex items-start gap-2.5">
                  <span class="text-teal-400 font-bold">✓</span>
                  <span><strong>Everything in Gold Tier:</strong> Full 90-day content stack and 12-month workshop access</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-teal-400 font-bold">✓</span>
                  <span><strong>Second 10k-Follower AI Influencer:</strong> Double your market presence across two distinct niches</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-teal-400 font-bold">✓</span>
                  <span><strong>Dedicated 1:1 Slack Mentor:</strong> Direct daily communication with Room30 implementation staff</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-teal-400 font-bold">✓</span>
                  <span><strong>Monthly 1:1 Zoom Strategy Calls:</strong> High-level campaign optimization and monetization reviews</span>
                </li>
              </ul>
            </div>
            <div class="mt-8 pt-6 border-t border-slate-800">
              <a
                href="/go/dfy-influencer"
                class="w-full inline-flex items-center justify-center px-6 py-3.5 text-sm font-bold rounded-xl bg-gradient-to-r from-teal-400 to-emerald-400 text-slate-950 hover:from-teal-300 hover:to-emerald-300 transition-all shadow-lg active:scale-95"
              >
                <span>Apply for Diamond Tier ($9,997) →</span>
              </a>
            </div>
          </div>
        </div>

        <div class="text-center">
          <p class="text-xs text-slate-500">
            All builds executed under formal online service agreement with verified Stripe payment processing.
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- Pain points, transformation & benefits tailored to this exact avatar -->
  <FeaturesBreakdown
    audience={spoke.audience}
    avatarContext={spoke.avatarContext}
    painPoints={spoke.painPoints}
    keyBenefits={spoke.keyBenefits}
  />

  {spoke.category === "reviews" && (
    <section class="py-12 bg-slate-900/30 border-b border-slate-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">
          Verified Independent Audit & Scorecard
        </h2>
        <p class="text-slate-400 text-sm mb-8">
          Objective evaluation of system delivery, privacy architecture, founder credibility, and unit economics.
        </p>
        <div class="rounded-2xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-950">
          <img
            src="/images/room30-system-audit-scorecard.webp"
            alt="Independent system audit scorecard and verification for Room30 AI Influencer Portfolio showing 9.4 trust score and evaluation metrics"
            width="1376"
            height="768"
            class="w-full h-auto object-cover rounded-2xl"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>
  )}

  <!-- Direct comparison table vs old DIY approaches -->
  <ComparisonTable />

  <!-- FAQ Accordion with rich FAQPage schema markup -->
  <FAQAccordion faqList={spoke.faqList} />

  <!-- Related Spoke Blueprints (Internal Linking Mesh) -->
  <section class="py-16 bg-slate-900/40 border-t border-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-xl sm:text-3xl font-bold text-white tracking-tight mb-2">
          Related AI Portfolios & Use Cases
        </h2>
        <p class="text-slate-400 text-sm">
          Explore specialized turnkey frameworks designed for complementary professions, channels, and business models.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedSpokes.map((rel) => (
          <a
            href={`${rel.categoryPath}${rel.slug}/`}
            class="group rounded-2xl border border-slate-800 bg-slate-950/80 p-6 hover:border-emerald-500/50 hover:bg-slate-900/60 transition-all flex flex-col justify-between shadow-lg"
          >
            <div>
              <span class="inline-block px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-400 text-xs font-semibold mb-3">
                {rel.badge}
              </span>
              <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-emerald-400 transition-colors mb-2">
                {rel.h1}
              </h3>
              <p class="text-xs sm:text-sm text-slate-400 line-clamp-2 mb-4">
                {rel.heroHeadline}
              </p>
            </div>
            <div class="inline-flex items-center text-xs font-semibold text-emerald-400 group-hover:translate-x-1 transition-transform">
              <span>View Blueprint</span>
              <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Fixed bottom conversion anchor -->
  <StickyCTA offerText={customStickyText} affiliateUrl={customAffiliateUrl} />
</BaseLayout>
