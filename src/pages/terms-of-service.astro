---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND_NAME } from '../data/pages';

const title = `Terms of Service | Legal Notice & User Agreement - ${BRAND_NAME}`;
const description = "Review the UGC DFY Terms of Service. Understand the rules, liability disclaimers, and user terms governing access to our AI media audit platform.";

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Terms of Service", url: "/terms-of-service/" }
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/terms-of-service/"
  breadcrumbs={breadcrumbs}
>
  <div class="py-16 md:py-24 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumbs -->
    <nav class="mb-8 flex items-center space-x-2 text-xs text-slate-400">
      <a href="/" class="hover:text-brand-400 transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-200">Terms of Service</span>
    </nav>

    <!-- Header Section (Strictly 1 H1) -->
    <header class="mb-12 border-b border-slate-800 pb-10">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-slate-500/10 border border-slate-500/20 text-slate-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>Legal Terms & User Agreement</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight mb-6">
        Terms of Service
      </h1>
      <p class="text-sm text-slate-400">
        Last Updated: October 13, 2026
      </p>
    </header>

    <!-- Content Body -->
    <div class="prose prose-invert max-w-none space-y-10 text-slate-300 leading-relaxed text-base">
      
      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-white tracking-tight">1. Agreement to Terms</h2>
        <p>
          By visiting or using <strong>UGC DFY</strong> (<a href="https://ugcdfy.com" class="text-brand-400 hover:underline">ugcdfy.com</a>), you agree to comply with and be bound by these Terms of Service. If you disagree with any portion of these terms, you should terminate your use of this website immediately.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-white tracking-tight">2. Non-Advisory Nature of Content</h2>
        <p>
          All evaluations, articles, scorecards, and media analyses published on UGC DFY are provided solely for <strong>informational and research purposes</strong>.
        </p>
        <p>
          UGC DFY is not a registered financial advisor, legal entity, or registered broker. Nothing on this website constitutes legal, business, or investment advice. You bear sole responsibility for conducting due diligence prior to purchasing third-party tools, digital assets, or done-for-you systems.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-white tracking-tight">3. Independent Third-Party Services</h2>
        <p>
          UGC DFY reviews external third-party software and marketplaces (such as Room30.ai and Soldi.ai/DFY Dave). UGC DFY is not a party to contracts, account sales, or escrow agreements executed between you and external third parties. We assume no liability for platform suspensions, service outages, or terms changes instituted by third-party providers.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-white tracking-tight">4. Intellectual Property</h2>
        <p>
          All original textual reviews, graphics, diagrams, and layout architecture are the proprietary intellectual property of UGC DFY. Unauthorized scraping, automated reproduction, or distribution without prior written consent is strictly prohibited.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-white tracking-tight">5. Limitation of Liability</h2>
        <p>
          To the maximum extent permitted under applicable law, UGC DFY and its affiliates shall not be liable for any indirect, consequential, or exemplary damages, including loss of revenue, loss of audience, or algorithmic penalties arising from your implementation of reviewed tools.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-white tracking-tight">6. Inquiries & Notices</h2>
        <p>
          Questions concerning these Terms of Service should be directed to:
        </p>
        <p class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 not-prose text-sm text-slate-300">
          <strong>UGC DFY Media</strong><br />
          Email: <a href="mailto:contact@ugcdfy.com" class="text-brand-400 hover:underline">contact@ugcdfy.com</a>
        </p>
      </section>

    </div>
  </div>
</BaseLayout>
